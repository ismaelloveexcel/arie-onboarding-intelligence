DATABASE_URL=postgresql://user:password@host:5432/dbname
# Required for non-interactive Railway CLI deploys from cloud agents.
RAILWAY_TOKEN=
# GitHub Actions secret name used by CI tests; workflow injects this into DATABASE_URL.
DATABASE_URL_TEST=postgresql://test_user:test_pass@localhost:5432/arie_test
COMPANIES_HOUSE_API_KEY=
APP_ENV=development
RM_NAMES=Ismael,Tasneem,Aisha,Stephen,Rajesh
ACTOR_NAMES=Ismael,Tasneem,Aisha,Stephen,Rajesh
# Actors allowed to open the Prospect Engine admin view.
ADMIN_ACTOR_NAMES=Ismael
# Demo-only role switch. Keep false in production.
PROSPECT_ENGINE_DEMO_MODE=false
# Compliance/footer wording shown in the weekly preview and email-safe template.
# Must be approved before production use.
PROSPECT_ENGINE_FOOTER_TEXT="Internal ARIE Finance working draft. Suggested opening angles are draft notes for RM review, not automated outreach. Regulatory wording requires approval before production use."
LOG_LEVEL=INFO
# Required in production. Used to sign the actor cookie so a user cannot
# spoof another RM's name by editing their browser cookie. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Required to use /admin/* endpoints. Bearer-token auth, constant-time compared.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Send as: Authorization: Bearer <token>
ADMIN_TOKEN=
# Optional fail-closed DB host guard. If set, DATABASE_URL host must contain
# one of these comma-separated substrings, otherwise the app refuses to start.
# Example for local dev: ALLOWED_DB_HOSTS=localhost,127.0.0.1
# Example for prod: ALLOWED_DB_HOSTS=<your-prod-db-host-substring>
ALLOWED_DB_HOSTS=
