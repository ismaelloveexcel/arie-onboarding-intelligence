DATABASE_URL=postgresql://user:password@host:5432/dbname
# GitHub Actions secret name used by CI tests; workflow injects this into DATABASE_URL.
DATABASE_URL_TEST=postgresql://test_user:test_pass@localhost:5432/arie_test
COMPANIES_HOUSE_API_KEY=
APP_ENV=development
RM_NAMES=Ismael,Tasneem,Aisha,Stephen,Rajesh
ACTOR_NAMES=Ismael,Tasneem,Aisha,Stephen,Rajesh
LOG_LEVEL=INFO
# Required in production. Used to sign the actor cookie so a user cannot
# spoof another RM's name by editing their browser cookie. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Required to use /admin/* endpoints. Bearer-token auth, constant-time compared.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Send as: Authorization: Bearer <token>
ADMIN_TOKEN=
# Optional fail-closed DB host guard. If set, DATABASE_URL host must contain
# one of these comma-separated substrings, otherwise the app refuses to start.
# Example for local dev: ALLOWED_DB_HOSTS=localhost,127.0.0.1
# Example for prod: ALLOWED_DB_HOSTS=<your-prod-db-host-substring>
ALLOWED_DB_HOSTS=

# PR1a shadow scoring flags (foundation-only; no ranking change)
SCORING_SHADOW_MODE=true
SCORING_DISPLAY_ENABLED=false
SHADOW_SCORE_ACTIVE_STALE_DAYS=120
SHADOW_BACKFILL_BATCH_SIZE=100
SHADOW_BACKFILL_MAX_BATCHES=20
SHADOW_BACKFILL_LOCK_TIMEOUT_MS=3000
# Comma-separated explicit terminal statuses excluded from active backfill selection
ACTIVE_TERMINAL_STATUSES=Client,Closed - Not Fit,Not Fit,Archived
